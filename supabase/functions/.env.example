# For local `supabase functions serve --env-file supabase/functions/.env`.
# For a deployed function, set these with `supabase secrets set` instead —
# never commit the real values either way.

LEAN_CLIENT_ID=your-lean-application-id
LEAN_CLIENT_SECRET=your-lean-client-secret
LEAN_AUTH_BASE_URL=https://auth.sa.leantech.me
LEAN_API_BASE_URL=https://sandbox.sa.leantech.me
